{
  "name": "reviewflow-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MCP 기반 GitHub, Jira 및 AI 코드 리뷰 자동화 서버 테스트",
  "type": "module",
  "scripts": {
    "review:github": "node --env-file=.env --import tsx src/cli/github-review.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/auth/*.test.ts src/github/*.test.ts src/jira/*.test.ts src/review/*.test.ts",
    "mcp:http": "node --env-file=.env --import tsx src/server/server-http.ts",
    "start": "node --import tsx src/server/server-http.ts"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jose": "^6.2.10",
    "openai": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
