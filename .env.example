# ReviewFlow 환경변수 설정 예시
#
# 로컬 실행:
#   cp .env.example .env
#   생성된 .env에 실제 값을 입력합니다.
#
# 배포 환경:
# 사용하는 호스팅 서비스의 환경변수 설정에
# 동일한 이름과 실제 값을 등록합니다.
# 예: Render Dashboard → Environment
#
# 실제 비밀값이 들어 있는 .env 파일은 Git에 올리지 않습니다.

# ============================================================
# ReviewFlow 서버 필수 설정
# 로컬에서 실행할 때는 .env에 등록합니다.
# 배포할 때는 호스팅 서비스의 환경변수 설정에 등록합니다.
# ============================================================

# OpenAI 코드 리뷰에 사용합니다.
OPENAI_API_KEY=replace-with-openai-api-key

# GitHub API에서 Pull Request와 변경 파일을 조회할 때 사용합니다.
GITHUB_TOKEN=replace-with-github-token

# ReviewFlow 내부 /mcp 엔드포인트를 보호합니다.
# 다음 명령으로 임의의 토큰을 생성할 수 있습니다.
# openssl rand -hex 32
MCP_API_TOKEN=replace-with-random-token

# ReviewFlow 실행을 허용할 GitHub 저장소 목록입니다.
# 여러 저장소는 쉼표로 구분합니다.
REVIEWFLOW_ALLOWED_REPOSITORIES=owner/repository,owner/another-repository

# ============================================================
# 선택적 Jira 연동
# Jira를 사용하지 않는다면 등록하지 않아도 됩니다.
# 로컬에서 실행할 때는 .env에 등록합니다.
# 배포할 때는 호스팅 서비스의 환경변수 설정에 등록합니다.
# ============================================================

# Jira 사이트 주소입니다.
JIRA_BASE_URL=https://your-domain.atlassian.net

# Jira API 토큰을 발급한 계정의 이메일입니다.
JIRA_EMAIL=your-email@example.com

# Jira API 접근에 사용하는 토큰입니다.
JIRA_API_TOKEN=replace-with-jira-api-token

# PR 생성·업데이트 시 Jira 티켓을 검토 중으로 이동할 때
# 사용하는 Jira 상태 ID입니다.
JIRA_REVIEW_STATUS_ID=replace-with-jira-review-status-id

# ============================================================
# 로컬 실행 전용 설정
# 배포 환경에서는 별도로 등록하지 않습니다.
# ============================================================

# 로컬 HTTP 서버 포트입니다.
# 배포 환경에서는 호스팅 서비스가 제공하는 PORT를 사용합니다.
# PORT가 제공되지 않는 환경에서는 직접 설정할 수 있습니다.
PORT=5200
# pnpm review:github으로 수동 리뷰할 때 연결할 MCP 주소입니다.
MCP_SERVER_URL=http://127.0.0.1:5200/mcp