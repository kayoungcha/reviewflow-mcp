# ReviewFlow 환경변수 설정 예시
# 이 파일 자체는 Render나 GitHub Actions에서 자동으로 읽지 않습니다.
# 로컬 실행 전:
#   cp .env.example .env
#   생성된 .env에 실제 값을 입력합니다.
#
# Render 배포:
#   아래의 서버 환경변수 이름과 실제 값을
#   Render Dashboard의 Environment에 직접 등록합니다.
#
# 실제 비밀값이 들어 있는 .env 파일은 Git에 올리지 않습니다.


# ============================================================
# ReviewFlow 서버 필수 설정
# 로컬 실행시 .env 또는 Render Environment에 등록합니다.
# ============================================================

# OpenAI 코드 리뷰에 사용합니다.
OPENAI_API_KEY=replace-with-openai-api-key

# GitHub API에서 PR 정보와 변경 파일을 조회할 때 사용합니다.
GITHUB_TOKEN=replace-with-github-token

# ReviewFlow의 /mcp 엔드포인트를 보호하고,
# 리뷰 서비스와 MCP 클라이언트가 인증할 때 사용합니다.
# openssl rand -hex 32
MCP_API_TOKEN=replace-with-random-token

# ReviewFlow 리뷰 실행을 허용할 GitHub 저장소입니다.
# 여러 저장소는 쉼표로 구분합니다.
REVIEWFLOW_ALLOWED_REPOSITORIES=owner/repository


# ============================================================
# 선택적 Jira 연동
# Jira를 사용하지 않는다면 등록하지 않아도 됩니다.
# ============================================================

JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=replace-with-jira-api-token

# Jira 티켓을 검토 중으로 이동할 때 사용하는 상태 ID입니다.
JIRA_REVIEW_STATUS_ID=replace-with-jira-review-status-id

# ============================================================
# 로컬 실행 전용 설정
# Render에서는 PORT를 자동으로 제공합니다.
# ============================================================

# 로컬 HTTP 서버 포트입니다.
PORT=5200
# pnpm review:github으로 수동 리뷰할 때 연결할 MCP 주소입니다.
MCP_SERVER_URL=http://127.0.0.1:5200/mcp